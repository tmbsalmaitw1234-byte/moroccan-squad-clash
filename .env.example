# Copy this file to .env and fill in your Supabase project values
# (Supabase dashboard → Project Settings → API).
# Leave both empty to run the in-browser demo instead.
#
# The anon key is designed to be public: security comes from the Row Level
# Security policies and server functions in supabase/schema.sql.
# NEVER put the service_role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
